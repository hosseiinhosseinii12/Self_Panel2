# Telegram API
API_ID=
API_HASH=

# Bot
BOT_TOKEN=
OWNER_ID=338266658

# Cloudflare Worker
CF_WORKER_DOMAIN=autumn-dust-5fb8.v2config.workers.dev

# Admin
ADMIN_PASSWORD=
PORT=8080
SECRET_KEY=

# Economy
SIGNUP_BONUS=10
DIAMOND_COST_CLOCK=1
DIAMOND_COST_JOB=5
REFERRAL_BONUS=5

# Storage
DB_PATH=/data/selfbot

# Session Vault (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SESSION_ENCRYPTION_KEY=

# Backup schedule
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=10

# Auto-fetch on startup
AUTO_FETCH_ON_START=true
FETCH_PRIORITY=volume,r2,telegram

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=selfbot-sessions
R2_ENDPOINT=

# Telegram backup
BACKUP_TO_TELEGRAM=true

# API
API_TOKEN=

# Proxy
USE_PROXY=true
PROXY_URL=socks5://127.0.0.1:1080